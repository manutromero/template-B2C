{
    "flex-layout.col#container-button-terminos-condiciones-one": {
        "title": "Contendor botones pdf bloque 1",
        "children": [
            "link#pdf-1-terminos",
            "link#pdf-2-terminos",
            "link#pdf-3-terminos",
            "link#pdf-4-terminos"
        ],
        "props": {
            "blockClass": "container-buttons-pdf",
            "fullWidth": true,
            "preserveLayoutOnMobile": true,
            "preventHorizontalStretch": true
        }
    },
    "flex-layout.col#container-button-terminos-condiciones-two": {
        "title": "Contendor botones pdf bloque 2",
        "children": [
            "link#pdf-5-terminos",
            "link#pdf-6-terminos",
            "link#pdf-7-terminos",
            "link#pdf-8-terminos"
        ],
        "props": {
            "blockClass": "container-buttons-pdf",
            "fullWidth": true,
            "preserveLayoutOnMobile": true,
            "preventHorizontalStretch": true
        }
    },
    "icon#caret-right": {
        "title": "icono",
        "props": {
            "id": "nav-thin-caret--right",
            "size": "18",
            "activeClassName": "vtex-blue-icon"
        }
    },
    "link#pdf-1-terminos": {
        "title": "Button política general garantía",
        "props": {
            "href": "/",
            "label": "Política general de garantía",
            "target": "_blank",
            "displayMode": "button",
            "buttonProps": {
                "variant": "secundary",
                "size": "regular"
            },
            "blockClass": "button-pdf-terminos"
        },
        "children": [
            "icon#caret-right"
        ]
    },

			"title": "Logo",
			"href": "/",
			"url": "/arquivos/Logo-ITG.svg",
			"width": 125,
			"height": 55,
			"blockClass": "logo"
		}
	},

	//navbar links
	"link#promotions": {
		"props": {
			"label": "PROMOCIONES",
			"href": "/promociones",
			"blockClass": "promotions"
		}
	},
	"link#about-us": {
		"props": {
			"label": "Sobre Nosotros",
			"href": "/sobre-nosotros",
